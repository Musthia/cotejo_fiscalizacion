             <string notr="true">QLabel {
    /* Gradiente invertido suave en tonos plata/aluminio (simula profundidad fija) */
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
                                      stop:0 rgb(200, 202, 205), 
                                      stop:1 rgb(230, 232, 235));
    /* Texto negro para máxima legibilidad sobre fondo claro */
    color: #000000; 
    
    /* Bordes rectos hundidos adaptados a la paleta clara */
    border-top: 2px solid #757a80;
    border-left: 2px solid #90959a;
    border-right: 1px solid #ffffff;
    border-bottom: 1px solid #ffffff;
    
    padding: 6px 12px;
    font-weight: bold;
