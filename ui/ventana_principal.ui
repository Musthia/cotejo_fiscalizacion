          <item row="1" column="5">
           <widget class="QPushButton" name="pushButton_5">
            <property name="styleSheet">
             <string notr="true">QPushButton {
    /* Gradiente de acero oscuro pulido (volumen hacia afuera) */
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
                                      stop:0 rgb(90, 95, 100), 
                                      stop:1 rgb(60, 65, 70));
    /* Texto blanco para contrastar fuertemente con el botón oscuro */
    color: #ffffff;
    /* Borde sutil pero definido */
    border: 1px solid #14191f;
    border-radius: 5px;
    padding: 6px 12px;
    font-weight: bold;
    font-size: 11px;
}

QPushButton:hover {
    /* Destello metálico: se aclara notablemente al pasar el mouse */
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
                                      stop:0 rgb(120, 125, 130), 
                                      stop:1 rgb(80, 85, 90));
}

QPushButton:pressed {
    /* Efecto hundido extremo (casi negro mate) */
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
                                      stop:0 rgb(40, 45, 50), 
                                      stop:1 rgb(55, 60, 65));
    border: 2px solid #14191f;
}

QPushButton:disabled {
    /* Gris apagado genérico para deshabilitado */
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #a0a5a8, stop:1 #858a8d);
    color: #d1d5d8;
    border: 1px solid #7f8c8d;
}
</string>
            </property>
            <property name="text">
             <string>PushButton</string>
            </property>
           </widget>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="label_5">
            <property name="styleSheet">
             <string notr="true">QLabel {
    /* Gradiente invertido suave en tonos plata/aluminio (simula profundidad fija) */
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
                                      stop:0 rgb(200, 202, 205), 
                                      stop:1 rgb(230, 232, 235));
    /* Texto negro para máxima legibilidad sobre fondo claro */
    color: #000000; 
    
    /* Bordes rectos hundidos adaptados a la paleta clara */
    border-top: 2px solid #757a80;
    border-left: 2px solid #90959a;
    border-right: 1px solid #ffffff;
    border-bottom: 1px solid #ffffff;
    
    padding: 6px 12px;
    font-weight: bold;
    font-size: 11px;
}
</string>
            </property>
            <property name="text">
             <string>TextLabel</string>
            </property>
            <property name="alignment">
             <set>Qt::AlignmentFlag::AlignRight|Qt::AlignmentFlag::AlignTrailing|Qt::AlignmentFlag::AlignVCenter</set>
            </property>
           </widget>
