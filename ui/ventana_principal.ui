          <item row="2" column="0">
           <widget class="QPushButton" name="pushButton_datos_db_2">
            <property name="cursor">
             <cursorShape>PointingHandCursor</cursorShape>
            </property>
            <property name="styleSheet">
             <string notr="true">QPushButton {
    /* Gradiente de acero oscuro pulido (volumen hacia afuera) */
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
                                      stop:0 rgb(90, 95, 100), 
                                      stop:1 rgb(60, 65, 70));
    /* Texto blanco para contrastar fuertemente con el botón oscuro */
    color: #ffffff;
    /* Borde sutil pero definido */
    border: 1px solid #14191f;
    border-radius: 5px;
    padding: 6px 12px;
    font-weight: bold;
    font-size: 11px;
}

QPushButton:hover {
    /* Destello metálico: se aclara notablemente al pasar el mouse */
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
                                      stop:0 rgb(120, 125, 130), 
                                      stop:1 rgb(80, 85, 90));
}

QPushButton:pressed {
    /* Efecto hundido extremo (casi negro mate) */
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
                                      stop:0 rgb(40, 45, 50), 
                                      stop:1 rgb(55, 60, 65));
    border: 2px solid #14191f;
}

QPushButton:disabled {
    /* Gris apagado genérico para deshabilitado */
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #a0a5a8, stop:1 #858a8d);
    color: #d1d5d8;
    border: 1px solid #7f8c8d;
}
</string>
            </property>
            <property name="text">
             <string>BASES DE DATOS</string>
            </property>
           </widget>
