          <item row="1" column="3">
           <widget class="QPushButton" name="pushButton_3">
            <property name="cursor">
             <cursorShape>PointingHandCursor</cursorShape>
            </property>
            <property name="styleSheet">
             <string notr="true">QPushButton {
    /* Base de acero azul oscuro profundo (volumen hacia afuera) */
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
                                      stop:0 rgb(50, 65, 85), 
                                      stop:1 rgb(30, 40, 55));
    color: #FFFFFF;
    /* Borde oscuro con reflejo superior azul brillante */
    border: 1px solid #0b111a;
    border-top: 1px solid #6391c2; 
    border-radius: 6px;
    padding: 7px 14px;
    font-weight: bold;
    font-size: 12px;
}

QPushButton:hover {
    /* El azul base se enciende e intensifica notablemente */
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
                                      stop:0 rgb(80, 110, 145), 
                                      stop:1 rgb(45, 65, 90));
    /* Texto cian brillante para máximo contraste en hover */
    color: #3ae2ff;
    /* Bordes eléctricos integrados */
    border: 1px solid #163654;
    border-top: 1px solid #5cb3ff;
}

QPushButton:pressed {
    /* Hundimiento extremo en azul marino casi negro */
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
                                      stop:0 rgb(15, 25, 40), 
                                      stop:1 rgb(25, 35, 50));
    color: #00bfff;
    border: 1px solid #050b14;
    padding-top: 8px;
    padding-bottom: 6px;
}

QPushButton:disabled {
    /* Desaturado completo (gris ligeramente frío) para indicar inactividad */
    background-color: #4b525a;
    color: #828a94;
    border: 1px solid #363b40;
}
</string>
            </property>
            <property name="text">
             <string>PushButton</string>
            </property>
           </widget>
